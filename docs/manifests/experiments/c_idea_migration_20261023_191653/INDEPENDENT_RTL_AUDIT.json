  "control_lifetime_audit": {
    "applicable_candidates": [
      "c_control",
      "c_shared"
    ],
    "descriptor": "saved_descriptor is assigned only on reset or LOAD_DESCRIPTOR. An outstanding CHAIN/EMIT macro cannot enter LOAD_DESCRIPTOR or accept a program control before complete_macro. Aliasing chain_descriptor and descriptor fields to it preserves latched values for arbitrary admitted ROM macro/control streams.",
    "leaf": "Inside a CHAIN, previous task_leaf writes only restored chain_leaf; hash request/response, endpoint writes, L-tree, output and route do not change task_leaf. Program CTX_LEAF writes cannot interleave the macro. Retaining task_leaf removes duplicate storage without losing a live coordinate.",
    "address": "indexing==1 executes a single FORS chain setup and preserves the initial task_b. index!=1 explicitly sets task_b from its digit or zero on each CHAIN_SETUP as before. Any later reduction/L-tree B write completes the chain macro before another FORS setup can occur.",
    "emit": "emit_base/count are read from saved_descriptor while that same EMIT macro remains outstanding. OUTPUT_CHUNK and EMIT_NEXT do not modify saved_descriptor.",
    "cycles_handshake": "No FSM state, branch target, handshake, data-memory write state, sequencing completion, or recipe admission condition is added/removed. Repeated coordinate restores are removed only under the lifetime invariants above.",
    "reject_and_reset": "Profile/q/ROM/control bounds and error priority are unchanged; original task context/descriptor reset and abort behavior is retained. Removed private FF names are not interface fields."
  },
  "formatter_audit": {
    "applicable_candidates": [
      "c_shared",
      "i_shared",
      "t_shared"
    ],
    "scope": "Only scalar P1 fixed formatting and c/i scalar stream absorb are changed. The entire scheduled_execution P>1 branch is byte-identical to its same-design baseline. Ports, parameters, preprocessor guards, shape capture and FSM sequential updates are unchanged.",
    "one_hot": "seed_shapes and step_shapes are captured as (16'b1 << request_recipe[59:56]) & RECIPE_MASK. Thus the shape used by the new complete-frame masked-OR network is either one enabled bit or zero. MASKED_VALUE KEY/MASK and FINAL predicates partition that bit; no disabled recipe becomes enabled.",
    "node_widths": "Runtime node_bytes=16 and 24 format branches are unchanged. At runtime 32, c/t old 256-bit frame registers zero-extended structural node fields; explicit unsigned 256-bit casts preserve that width before full-frame concatenation. Padding offsets (including final rate-bit 1087) and arity-specific padding at bit 1024 are retained.",
    "chain_and_mask_liveness": "The network reads the same retained key, chain_value, digest, request_right and chain feedback at the same launch/feedback clock. No storage bank or write enable is changed, so a right node, masked left node, pending capture and final digest retain their prior simultaneous lifetimes.",
    "synthesis_view": "No change to SYNTHESIS guards, debug ports, counter/update blocks or statistical events. Datapath replacement is the same in normal/SYNTHESIS views.",
    "width_scope_caveat": "i already had the one-hot topology. Its new explicit 256-bit casts normalize old concatenation for deliberately mismatched structural N<32 with runtime node_bytes=32; such a node size cannot be represented by those N-wide data ports. This is outside current common cores (all instantiate N=32), and outside meaningful N>=node_bytes use. No claim of byte-equivalence is made for this mismatched combination."
  },
  "stream_absorb_audit": {
    "changed_candidates": [
      "c_shared",
      "i_shared"
    ],
    "t_shared": "Already had the same local absorb topology; stream code retained.",
    "proof": "For a selected word w<17, append_index==floor(w/2). The old shared previous_rate half is exactly sponge_state[w*64+:64], and the staged half is selected by w parity. The local XOR therefore yields the same next word. At w=16 only the low 64 bits are used, as before.",
    "clear_and_capacity": "clear_stream masks the prior state on the first beat and retains the original clear/write enables for all 25 words. Unselected rate words and capacity words receive the same old next_word and enable behavior.",
    "stalls_and_padding": "staged_data/staged_valid capture, append-index advancement, stream_half, list prefetch, 136-byte last beat, fill/padding and Keccak round updates are unchanged. Selected stream absorption occurs in HASH_WAIT_BLOCK and cannot overlap HASH_RUN round feedback or fixed launch.",
    "cycles": "Pure combinational mux/XOR redistribution; no additional or removed cycles."
  },
