  "changes": [
    {
      "name": "Successor instruction lookahead",
      "behavior": "Existing token register loads the successor on retirement. Static NE/unconditional branches predict taken; other conditions predict fallthrough. Correct prediction and deterministic CALL/RET/LOOP avoid FETCH. A mismatch redirects through FETCH before executing the target.",
      "timing_boundary": "The predicted ROM address depends on registered token/PC/return/loop metadata, never on the late context ALU/branch result. Conditional resolution still gates retirement and selected PC state."
    },
    {
      "name": "FORS operand staging",
      "behavior": "A control instruction reading CTX_FORS_TARGET snapshots both narrow operands in a dedicated CONTROL_OPERANDS state and retires after actual execution. Other controls retain immediate retirement.",
      "timing_boundary": "Introduces42bits of operand registers before arithmetic/branch/legality/writeback. Actual mapped STA must verify whether the fast/live selector leaves a structural path through the old lookup; no frequency claim is made."
    },
    {
      "name": "Descriptor capture and decode",
      "behavior": "LOAD_DESCRIPTOR captures descriptor_data and decodes macro on the same edge; task_recipe remains registered before HASH_ISSUE. Verification R/C special handling and TRANSFORM/EMIT decode rules retained.",
      "expected_cycles": "Removes the old DECODE bubble per template without ROM-to-hash combinational bypass."
    },
    {
      "name": "HASH retirement",
      "behavior": "HASH_WAIT captures lane_value into result. Identity route completes the macro there; nonidentity routes enter ROUTE using the newly registered result.",
      "expected_cycles": "Removes HASH_RESULT on all completed HASH requests and removes identity ROUTE. Nonidentity data parsing/output retain the result-register boundary."
    }
  ],
