+    // Select the upper half after independent carry-in-zero/one sums.
+    // Only the lower 16 bits propagate the carry used by the final mux.
+    function automatic [31:0] carry_select_16(input [31:0] x, y);
+        reg [16:0] lower;
+        reg [15:0] upper_zero, upper_one;
+        begin
+            lower = {1'b0,x[15:0]} + {1'b0,y[15:0]};
+            upper_zero = x[31:16] + y[31:16];
+            upper_one = x[31:16] + y[31:16] + 16'd1;
+            carry_select_16 = {lower[16] ? upper_one : upper_zero,lower[15:0]};
+        end
+    endfunction
