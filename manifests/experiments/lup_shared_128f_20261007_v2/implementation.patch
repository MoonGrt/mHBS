+ with (d/'vivado.log').open('w') as f:subprocess.run(['vivado','-mode','batch','-nolog','-nojournal','-source',str(d/'synth.tcl')],cwd=ws,stdout=f,stderr=subprocess.STDOUT,check=True)
+ assert f'LUP_COMMON_SYNTH_PASS L2U1P{p}' in (d/'vivado.log').read_text()
+ a=area(d/'core_utilization.rpt');write(d/'synthesis.json',dict(passed=True,area=a,elapsed_seconds=time.time()-start,profile_enable=False,routed=False));print('LUP_SYNTH_PASS',f'L2U1P{p}',int(a['lut']),int(a['ff']),flush=True);return a
