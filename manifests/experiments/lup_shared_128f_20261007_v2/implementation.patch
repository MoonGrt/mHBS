+                 2: rho_offset = 62;  3: rho_offset = 28;
+                 4: rho_offset = 27;  5: rho_offset = 36;
+                 6: rho_offset = 44;  7: rho_offset =  6;
+                 8: rho_offset = 55;  9: rho_offset = 20;
