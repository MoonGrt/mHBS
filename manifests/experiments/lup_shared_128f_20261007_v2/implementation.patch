+
+def prepare_baseline(out):
+ archive=out/'baseline.tar.gz'
+ if not archive.exists():
+  frozen=ROOT/'manifests/experiments/lup_shared_128f_20261007_v1/baseline.tar.gz'
+  shutil.copy2(frozen,archive)
