+    function automatic [63:0] rotl64;
+        input [63:0] value;
+        input integer amount;
+        begin
+            rotl64 = amount == 0 ? value
+                : (value << amount) | (value >> (64-amount));
+        end
+    endfunction
+
+    function automatic integer rho_offset;
+        input integer x;
+        input integer y;
