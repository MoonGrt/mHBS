+ 'set bad {}', 'foreach c [get_cells -hier -filter {IS_PRIMITIVE == 1}] {', ' if {[string match FD* [get_property REF_NAME $c]] && [regexp {(cycles|hash_count|permutation_count|hash_base|permutation_base)_reg} $c]} {lappend bad $c}', '}', 'if {[llength $bad]} {error "Statistics registers remain: $bad"}',f'set f [open {{{d/"pruning_audit.json"}}} w]', 'puts $f {{"passed":true,"profile_enable":false,"statistics_registers":0}}','close $f',f'write_checkpoint -force {{{d/"post_synth.dcp"}}}',f'puts "LUP_COMMON_SYNTH_PASS L2U1P{p}"','exit']
