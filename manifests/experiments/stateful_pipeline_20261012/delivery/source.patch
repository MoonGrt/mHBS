+        rows.append((req,int.from_bytes(value,'little'),int.from_bytes(capture,'little')))
+    for k,name,width in ((0,'requests',128),(1,'results',64),(2,'captures',64)):
+        (d/f'{name}.mem').write_text(''.join(f'{r[k]:0{width}x}\n' for r in rows))
+    return d
